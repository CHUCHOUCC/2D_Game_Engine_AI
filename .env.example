# Copy to .env (never commit .env). On Render, set these as environment variables.
# production: refuses to start with a weak key and hides /docs.
ENVIRONMENT=development
# Same value as AI_SERVICE_KEY in the backend; 32+ random characters.
# The backend signs a 60-second token with it for every call; the key itself never travels.
AI_SERVICE_KEY=change-me-to-a-long-random-string-of-32-plus-chars
AI_PROVIDER=simulated
# Only for AI_PROVIDER=openai_compatible:
# AI_BASE_URL=https://api.example.com/v1
# AI_API_KEY=your-provider-key
# AI_MODEL=model-name

# Cache of generated objects: how many answers and for how long (seconds).
AI_CACHE_SIZE=256
AI_CACHE_TTL=1800
